{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "strict": true,
    "sourceMap": true,
    "rootDir": ".",
    "types": ["jquery"],
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "scripthost"
    ]
  },
  "include": [
    "./static/js/*.ts",
    "./api/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
